# ========================================================
# Dukaan Ready - Environment Configuration Example
# ========================================================

# 1. AI API Keys (Add ANY ONE key, or leave blank to use Local AI Engine):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# 2. Supabase Storage (Optional - defaults to local fallback):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 3. Base App URL:
NEXT_PUBLIC_APP_URL=http://localhost:3000
